PORT=8080

# Menggunakan SQL Server untuk db ya mas mba adek
DB_HOST=localhost
DB_PORT=1433
DB_USER=panda_user
DB_PASSWORD=<ganti_dengan_password_database>
DB_NAME=PandaDB
DB_ENCRYPT=disable

JWT_SECRET=<ganti_dengan_string_acak_panjang>
INITIAL_ADMIN_BADGE=2411249
BYPASS_PASSWORD=Panda

UPLOAD_MAX_MB=25

# Isi MINIO_ACCESS_KEY & MINIO_SECRET_KEY untuk simpan dokumen ke MinIO, kosongkan untuk simpan di folder uploads/
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=panda-documents
MINIO_USE_SSL=false
MINIO_REGION=us-east-1

# Di dalam aplikasi bisa kita configure sendiri, tapi kalau mau pakai LLM bawaan (builtin) cukup kosongkan LLM_API_KEY
LLM_PROVIDER=builtin
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_API_KEY=
LLM_SHARE_DOC_CONTENT=false
LLM_CHAT_HISTORY_TURNS=10
LLM_THINKING_MAX_STEPS=0

# Di dalam aplikasi bisa kita configure sendiri, tapi kalau mau pakai Rerank bawaan (none) cukup kosongkan RERANK_API_KEY
RERANK_PROVIDER=none
RERANK_BASE_URL=
RERANK_MODEL=
RERANK_API_KEY=
RERANK_CANDIDATES=30
RERANK_TOP_N=8
