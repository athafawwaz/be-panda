# Salin menjadi backend/.env; jalankan backend dari direktori backend/.
# Template ini bukan konfigurasi siap produksi. Jangan commit .env atau secret.
PORT=8080

# PostgreSQL dev: docker compose up -d --wait postgres
# Compose membuat database/user pada volume baru; BE dijalankan di host.
# Ubah password hanya dengan prosedur rotasi DB jika volume sudah berisi data.
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=panda_user
DB_PASSWORD=
DB_NAME=panda
# disable khusus koneksi Docker lokal; gunakan verify-full untuk server bertLS.
DB_SSLMODE=disable

# Wajib: string acak minimal 32 karakter; nilai kosong membuat API gagal startup.
# Contoh generator: node -e 'console.log(require("node:crypto").randomBytes(32).toString("hex"))'
# Jangan rotasi sembarangan: token lama batal dan API key AI tersimpan bisa perlu diisi ulang.
JWT_SECRET=

# Login bersama ini sengaja dipertahankan untuk PoC, bukan untuk produksi.
INITIAL_ADMIN_BADGE=2411249
BYPASS_PASSWORD=Panda

# Ukuran maksimum per file, dalam MB.
UPLOAD_MAX_MB=25

# Opsional: semua endpoint/key/secret/bucket harus terisi untuk mengaktifkan MinIO.
# Biarkan key/secret kosong untuk menyimpan file di backend/uploads/.
MINIO_ENDPOINT=127.0.0.1:9000
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=panda-documents
MINIO_USE_SSL=false
MINIO_REGION=us-east-1

# Mode builtin berjalan tanpa API key eksternal.
# Pengaturan AI tersimpan dari menu Super Admin diprioritaskan atas environment.
LLM_PROVIDER=builtin
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_API_KEY=
# Jangan aktifkan pengiriman isi dokumen ke provider eksternal tanpa persetujuan.
LLM_SHARE_DOC_CONTENT=false
LLM_CHAT_HISTORY_TURNS=10
LLM_THINKING_MAX_STEPS=0

# Opsional: none menonaktifkan reranker eksternal.
RERANK_PROVIDER=none
RERANK_BASE_URL=
RERANK_MODEL=
RERANK_API_KEY=
RERANK_CANDIDATES=30
RERANK_TOP_N=8
